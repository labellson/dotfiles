// This look is mor or less the recommended by Noctalia docs
window-rule {
  // Rounded corners for a modern look.
  geometry-corner-radius 10

  // Clips window contents to the rounded corner boundaries.
  clip-to-geometry true
}

debug {
  // Allows notification actions and window activation from Noctalia.
  honor-xdg-activation-with-invalid-serial
}

// TODO: does this still applies in V5?
// Block out notifications from screencasts.
layer-rule {
    match namespace="^noctalia-notifications.*$"

    block-out-from "screencast"
}

binds {
    XF86MonBrightnessUp { spawn "noctalia" "msg" "brightness-up" "all"; }
    XF86MonBrightnessDown { spawn "noctalia" "msg" "brightness-down" "all"; }

    Super+Alt+L hotkey-overlay-title="Lock the Screen: swaylock" { spawn-sh "noctalia-shell ipc call lockScreen lock"; }

    // TODO: does not work on v5
    Super+Ctrl+W { spawn-sh "noctalia ipc call wallpaper toggle"; }

    // TODO: does not work on v5
    Super+Print { spawn-sh "noctalia msg plugin alexander/screen-toolkit:service all toggle"; }
}

// Documentation recommends spawn noctalia at the very end of the config file
spawn-at-startup "noctalia";
