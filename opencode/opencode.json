{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:OPENCODE_MODEL}",
  "small_model": "{env:OPENCODE_SMALL_MODEL}",
  "share": "disabled",
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local-new)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen3-coder:a3b": {
          "name": "Qwen3-Coder: 0.8B (local)",
          "limit": {
            "context": 128000,
            "output": 65536
          }
        }
     }
    },
    "headroom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Headroom Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1"
      }
    },
    "copilot": {}
  },
  "plugin": [
    "@mohak34/opencode-notifier@latest",
    "@slkiser/opencode-quota@4"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "enabled": false,
      "url": "https://mcp.context7.com/mcp"
    },
    "headroom": {
      "type": "local",
      "command": [
        "/home/labellson/.local/bin/headroom",
        "mcp",
        "serve"
      ],
      "enabled": true
    },
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "serena-agent",
        "serena",
        "start-mcp-server",
        "--project-from-cwd",
        "--context",
        "agent",
        "--open-web-dashboard",
        "False"
      ],
      "enabled": true
    }
  }
}
