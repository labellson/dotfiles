{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:OPENCODE_MODEL}",
  "agents": {
    "title": {
      "model": "{env:OPENCODE_SMALL_MODEL}"
    }
  },
  "share": "disabled",
  "providers": {
    "llama.cpp": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "llama-server (local-new)",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen3-coder:a3b": {
          "name": "Qwen3-Coder: 0.8B (local)",
          "limit": {
            "context": 128000,
            "output": 65536
          }
        }
      }
    },
    "headroom": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Headroom Proxy",
      "settings": {
        "baseURL": "http://127.0.0.1:8787/v1"
      }
    },
    "copilot": {}
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "disabled": true,
        "url": "https://mcp.context7.com/mcp"
      },
      "headroom": {
        "type": "local",
        "command": [
          "/home/labellson/.local/bin/headroom",
          "mcp",
          "serve"
        ],
        "disabled": false
      },
      "serena": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "serena-agent",
          "serena",
          "start-mcp-server",
          "--project-from-cwd",
          "--context",
          "agent",
          "--open-web-dashboard",
          "False"
        ],
        "disabled": false
      }
    }
  },
  "plugins": [
    "@mohak34/opencode-notifier@latest",
    "@slkiser/opencode-quota"
  ]
}
